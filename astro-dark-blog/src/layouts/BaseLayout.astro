---
import "../styles/global.css";

const {
  title = 'Astro Dark Blog',
  description = 'A simple Astro blog with dark mode, tags, and search.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Set theme ASAP to avoid flash -->
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
          const theme = stored || (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav">
        <a class="brand" href="/" aria-label="Home">
          <span class="dot" aria-hidden="true"></span>
          <span>Astro Dark Blog</span>
        </a>

        <nav class="nav-links" aria-label="Primary">
          <a class="pill" href="/">Home</a>
          <a class="pill" href="/tags">Tags</a>
          <a class="pill" href="/search">Search</a>
          <button id="themeToggle" class="pill" type="button" aria-label="Toggle dark mode">
            <span id="themeIcon" aria-hidden="true">🌓</span>
            <span class="meta" id="themeLabel">Theme</span>
          </button>
        </nav>
      </div>
    </header>

    <main class="container">
      <slot />

      <footer class="footer">
        <hr />
        <div>
          Built with Astro. Edit posts in <code>src/content/blog</code>.
        </div>
      </footer>
    </main>

    <script is:inline>
      (function () {
        const btn = document.getElementById('themeToggle');
        const icon = document.getElementById('themeIcon');
        const label = document.getElementById('themeLabel');
        if (!btn || !icon || !label) return;

        const getTheme = () => document.documentElement.getAttribute('data-theme') || 'dark';

        const sync = () => {
          const t = getTheme();
          const isDark = t === 'dark';
          icon.textContent = isDark ? '🌙' : '☀️';
          label.textContent = isDark ? 'Dark' : 'Light';
          btn.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
        };

        btn.addEventListener('click', () => {
          const next = getTheme() === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (_) {}
          sync();
        });

        sync();
      })();
    </script>
  </body>
</html>
