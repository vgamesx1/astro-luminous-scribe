---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPublishedPosts, getAllTags, filterByTag } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts).map(([tag]) => tag);
  return tags.map((tag) => ({
    params: { tag: encodeURIComponent(tag) },
    props: { tag }
  }));
}

const { tag } = Astro.props;
const posts = await getPublishedPosts();
const matches = filterByTag(posts, tag);
---

<BaseLayout title={`#${tag} • Astro Dark Blog`} description={`Posts tagged with ${tag}.`}>
  <section class="card" style="margin-bottom:16px">
    <h1 style="margin-top:0">#{tag}</h1>
    <p class="meta">{matches.length} post(s)</p>
    <div class="tags">
      <a class="tag" href="/tags">← All tags</a>
    </div>
  </section>

  <section aria-label="Tagged posts" style="display:flex; flex-direction:column; gap:16px">
    {matches.map((post) => (
      <PostCard post={post} />
    ))}
  </section>
</BaseLayout>
