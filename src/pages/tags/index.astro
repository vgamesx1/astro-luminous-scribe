---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedPosts, getAllTags } from '../../lib/posts';

const posts = await getPublishedPosts();
const tags = getAllTags(posts);
---

<BaseLayout title="Tags • Astro Dark Blog" description="Browse posts by tag.">
  <section class="card">
    <h1 style="margin-top:0">Tags</h1>
    <p class="meta">Click a tag to see matching posts.</p>

    {tags.length === 0 ? (
      <p class="meta">No tags yet. Add tags in a post's frontmatter.</p>
    ) : (
      <div class="tags">
        {tags.map(([tag, count]) => (
          <a class="tag" href={`/tags/${encodeURIComponent(tag)}`} title={`${count} post(s)`}>#{tag} ({count})</a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
