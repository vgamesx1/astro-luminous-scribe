---
const { tags = [] } = Astro.props;
const normalized = Array.from(new Set(tags)).map((t) => String(t)).filter(Boolean);
---

{normalized.length > 0 && (
  <div class="tags" aria-label="Tags">
    {normalized.map((tag) => (
      <a class="tag" href={`/tags/${encodeURIComponent(tag)}`}>#{tag}</a>
    ))}
  </div>
)}
